# aarch64 (ARM64) variant of the mlebench base image.
# Differences vs. the x86_64 Dockerfile:
#   * Miniconda installer URL uses the Linux-aarch64 asset.
#   * PyTorch trio (torch / torchvision / torchaudio) is pre-installed
#     from pytorch.org's cu124 aarch64 index so the Python side has GPU
#     support on SBSA hosts (Grace Hopper, Graviton-with-GPU, etc.).
#     Requires matching versions — 2.5.1 / 0.20.1 / 2.5.1 is the earliest
#     trio with full aarch64 cu124 coverage, so ``environment/requirements.txt``
#     was bumped to those pins.
# Shared with the x86_64 Dockerfile:
#   * TensorFlow is bumped to 2.19.0 (was 2.17.0) — 2.19's ``[and-cuda]``
#     extra pins ``nvidia-cudnn-cu12==9.3.0.75`` + ``nvidia-nccl-cu12==2.23.4``,
#     the first versions of both that ship aarch64 wheels. TF 2.17/2.18's
#     cuDNN/NCCL pins had no aarch64 wheels on PyPI.
#   * ``tensorpack==0.11`` was dropped from requirements.txt — the library
#     has been unmaintained since 2021 and is not compatible with TF 2.19.
# Build on an aarch64 host, e.g.:
#   docker build --platform=linux/arm64 -t mlebench-env \
#       -f environment/Dockerfile_aarch64 .
FROM ubuntu:20.04

# Avoid interactive dialog from apt-get and other packages requiring configuration
ENV DEBIAN_FRONTEND=noninteractive

# install basic packages
RUN apt-get update && apt-get install -y \
    curl \
    wget \
    git \
    vim \
    nano \
    unzip \
    zip \
    p7zip-full \
    python3 \
    python3-pip \
    python3-venv \
    python3-dev \
    python-is-python3 \
    build-essential \
    openssh-server \
    tmux \
    gettext \
    sudo \
    ffmpeg \
    libsm6 \
    libxext6 \
    && pip install jupyter \
    && rm -rf /var/lib/apt/lists/* # removes cache

RUN pip install virtualenv \
    && wget https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-aarch64.sh -O /tmp/miniconda.sh \
    && bash /tmp/miniconda.sh -b -p /opt/conda \
    && rm /tmp/miniconda.sh \
    && /opt/conda/bin/conda init

ARG CONDA_ENV_NAME=agent
ARG PYTHON_VERSION=3.12
ARG REQUIREMENTS=/tmp/requirements.txt

COPY environment/requirements.txt ${REQUIREMENTS}

RUN /opt/conda/bin/conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/main && \
    /opt/conda/bin/conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/r

# create conda environment and optionally install the requirements to it
RUN /opt/conda/bin/conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/main \
    && /opt/conda/bin/conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/r \
    && /opt/conda/bin/conda create -n ${CONDA_ENV_NAME} python=${PYTHON_VERSION} -y
ARG INSTALL_HEAVY_DEPENDENCIES=true
ENV INSTALL_HEAVY_DEPENDENCIES=${INSTALL_HEAVY_DEPENDENCIES}

# Install requirements. Two aarch64-specific pre-install steps:
#
# 1. PyTorch's default PyPI wheel on aarch64 is CPU-only, so we pre-install
#    the torch / torchvision / torchaudio trio from pytorch.org's cu124
#    aarch64 index BEFORE the requirements.txt step. The subsequent
#    ``pip -r`` sees these CUDA-enabled wheels as already satisfied and
#    doesn't downgrade them.
#
# After requirements.txt, we also install ``tensorflow[and-cuda]==2.19``
# to pull in the nvidia-* CUDA libs that ship aarch64 wheels at this TF
# version (cudnn 9.3.0.75 + nccl 2.23.4, both with manylinux2014_aarch64
# wheels — the reason we require TF ≥ 2.19 on aarch64).
RUN if [ "$INSTALL_HEAVY_DEPENDENCIES" = "true" ]; then \
    /opt/conda/bin/conda run -n ${CONDA_ENV_NAME} pip install \
        --index-url https://download.pytorch.org/whl/cu124 \
        torch==2.5.1 torchvision==0.20.1 torchaudio==2.5.1 && \
    /opt/conda/bin/conda run -n ${CONDA_ENV_NAME} pip install -r /tmp/requirements.txt && \
    /opt/conda/bin/conda run -n ${CONDA_ENV_NAME} pip install tensorflow[and-cuda]==2.19 && \
    /opt/conda/bin/conda clean -afy ; fi

ENV PATH="/opt/conda/bin:${PATH}"

# Installs from here onward go into the conda base env; previous was installed to /usr/bin/python

# Install stuff for the grading server: mlebench and flask
COPY . /mlebench
RUN /opt/conda/bin/conda create -n mleb python=${PYTHON_VERSION} -y
RUN /opt/conda/bin/conda run -n mleb pip install flask && \
    /opt/conda/bin/conda run -n mleb pip install -e /mlebench

# Reset DEBIAN_FRONTEND
ENV DEBIAN_FRONTEND=

# Make private directory (root) owner-only. Grading server will be added here, later in the build
# The test set answers will be added here separately via a mounted docker volume
RUN mkdir /private && chmod 700 /private

# Copy over relevant files
COPY environment/grading_server.py /private/grading_server.py
COPY environment/instructions.txt /home/instructions.txt
COPY environment/instructions_obfuscated.txt /home/instructions_obfuscated.txt
COPY environment/validate_submission.sh /home/validate_submission.sh
COPY environment/entrypoint.sh /entrypoint.sh

# install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Create nonroot user; make entrypoint executable
RUN useradd -m nonroot \
    && mkdir /home/submission \
    && chmod +x /entrypoint.sh

WORKDIR /home

# IMPORTANT: This needs to run as root! Downstream Dockerfiles must not change the default USER for when the container starts.
# Entrypoint script is in charge of setting up the user environment and running the grading server
ENTRYPOINT ["/entrypoint.sh"]
